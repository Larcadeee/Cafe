{
  "info": {
    "_postman_id": "coffeepos-api",
    "name": "CoffeePOS API",
    "description": "Complete authentication API for CoffeePOS - Kape Coffee Shop POS System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "signup"]
            },
            "description": "Create a new user account with email and password"
          },
          "response": []
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user with email and password. Returns access_token, refresh_token, and user data."
          },
          "response": []
        },
        {
          "name": "3. Get Google OAuth URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/auth/google-url",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "google-url"]
            },
            "description": "Get the Google OAuth authorization URL. Returns auth_url and state parameter for CSRF protection."
          },
          "response": []
        },
        {
          "name": "4. Google OAuth Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"AUTHORIZATION_CODE_FROM_GOOGLE\",\n  \"state\": \"STATE_PARAMETER_FROM_STEP_3\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/google-callback",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "google-callback"]
            },
            "description": "Exchange Google authorization code for tokens. Automatically creates or links user with Google account."
          },
          "response": []
        },
        {
          "name": "5. Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"YOUR_REFRESH_TOKEN_FROM_LOGIN\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "refresh"]
            },
            "description": "Get a new access token using the refresh token. Use when access token expires (15 min)."
          },
          "response": []
        },
        {
          "name": "6. Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ACCESS_TOKEN_FROM_LOGIN",
                "description": "Replace with actual access token from login response"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "me"]
            },
            "description": "Get current authenticated user data. Requires valid access token."
          },
          "response": []
        },
        {
          "name": "7. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ACCESS_TOKEN_FROM_LOGIN",
                "description": "Replace with actual access token from login response"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"YOUR_REFRESH_TOKEN_FROM_LOGIN\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "logout"]
            },
            "description": "Logout user and revoke refresh token. Requires valid access token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Test Cases",
      "item": [
        {
          "name": "Invalid Email (Signup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"invalid-email\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "signup"]
            },
            "description": "Test: Invalid email format should return 422 error"
          },
          "response": []
        },
        {
          "name": "Password Mismatch (Signup)",
