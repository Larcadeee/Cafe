            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"different_password\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "auth", "signup"]
            },
            "description": "Test: Password confirmation mismatch should return 422 error"
          },
          "response": []
